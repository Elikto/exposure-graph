# Core
APP_NAME=ExposureGraph
DATA_DIR=/data

# Flowsint local API; connect from the local ExposureGraph UI
FLOWSINT_BASE_URL=http://host.docker.internal:5001
FLOWSINT_API_TOKEN=
FLOWSINT_SKETCH_ID=

# Breach / threat intelligence
HIBP_API_KEY=
VT_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=

# Public connectors
ENABLE_GRAVATAR=true
ENABLE_RDAP=true
ENABLE_CRTSH=true
ENABLE_URLSCAN=true

# Broad username/email account discovery is delegated to the local Flowsint
# enrichers (including Maigret, Sherlock and Holehe) after local login.
