# Core
APP_NAME=ExposureGraph
DATA_DIR=/data

# Flowsint local API (OAuth2 bearer token required for graph/enricher calls)
FLOWSINT_BASE_URL=http://host.docker.internal:5001
FLOWSINT_API_TOKEN=
FLOWSINT_SKETCH_ID=

# Breach intelligence
HIBP_API_KEY=

# Optional reputation / infrastructure providers
VT_API_KEY=
SHODAN_API_KEY=

# Public connectors
ENABLE_GRAVATAR=true
ENABLE_RDAP=true
ENABLE_CRTSH=true
